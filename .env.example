# Copy to .env for local (non-Docker) development. docker-compose.yml sets its own values.
# The whole backend is async: PostgreSQL over asyncpg, SQLite over aiosqlite in tests.
DATABASE_URL=postgresql+asyncpg://storesplit:storesplit@localhost:5432/storesplit
LOG_LEVEL=INFO

# -- Tests --------------------------------------------------------------------------
# Tests run on in-memory SQLite unless this is set; setting it runs them, and the Alembic
# migration tests, against PostgreSQL. **Everything in it is dropped.** `app/db/safety.py`
# refuses before anything destructive runs unless the database is not DATABASE_URL, does not
# share its name, reads as a test database, is confirmed by the live connection, and either
# carries the disposable marker or is provably empty. Destructive test helpers must never
# target the development database: the suite fails closed unless the configured database is
# explicitly identified as disposable and separate from the application database.
#   TEST_DATABASE_URL=postgresql+asyncpg://storesplit:storesplit@localhost:5432/storesplit_test
#
# Waives the *name* rule only, and only for a database a CI job created and will throw away.
# It waives nothing else: a test database may never be DATABASE_URL, whatever these say.
#   CI=1
#   STORESPLIT_TEST_DB_IS_DISPOSABLE=1
# Comma-separated, matched as exact strings: a page at 127.0.0.1:3000 is a different
# origin than the same page at localhost:3000, so the dev frontend needs every spelling.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# HTTP: timeouts and the shared connection pool the long-lived clients use.
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30

# Kroger official developer API (https://developer.kroger.com). Optional: without
# credentials the Kroger adapter reports itself as not configured and is skipped.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Google Places API key. Optional: without it, a store's map link is a Google Maps place
# link when the retailer published one (Target, Safeway) and otherwise an address search
# naming the retailer. With it, StoreSplit resolves the business at each store's address
# once a week and keeps the place id, accepting a candidate only when its brand and
# street address match the store. Never called while answering a search.
GOOGLE_MAPS_API_KEY=

# Stores collected per retailer for one ZIP per scrape run.
SCRAPE_STORES_PER_RETAILER=2

# Scrape concurrency. Retailers run in parallel, and so do the (store, category) requests
# inside one retailer; both are bounded, so a run never launches unbounded tasks.
# Concurrent runs are serialized by default: two runs over one ZIP would fight over which
# offers are stale and delete each other's.
SCRAPE_MAX_CONCURRENT_RUNS=1
SCRAPE_MAX_CONCURRENT_RETAILERS=10
# One budget for a whole retailer, shared with any fan-out inside a single search.
SCRAPE_MAX_CONCURRENT_REQUESTS_PER_RETAILER=8
# A retailer past its own deadline is recorded as failed; the rest of the run continues.
SCRAPE_RETAILER_TIMEOUT_SECONDS=240
# Hard ceiling for one run; retailers still going when it fires are closed out as failed.
SCRAPE_DEADLINE_SECONDS=900

# Database connection pool (one engine per process).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30

# AI product judge. Disabled by default; the MVP never calls an AI provider.
AI_JUDGE_ENABLED=false

# -- Browser fallback (optional) -------------------------------------------------------
# The last acquisition step, for retailers that answer nothing else (Target, Walmart).
# Off by default: no ordinary scrape depends on a browser, and a headed window is not
# opened without asking. It never works around a challenge -- when a retailer asks for a
# human, the run says so and waits. See app/retailers/browser.py.
BROWSER_FALLBACK_ENABLED=false
# A persistent profile so cookies -- and any verification completed by hand -- are reused.
# BROWSER_PROFILE_DIR=~/.storesplit/browser-profile
# The profile scripts/start_chrome_cdp.py opens the DevTools port on, and therefore the one an
# attached run really shops in. It has to be a different directory -- a profile can only be
# open in one Chrome at a time -- so these two are two identities, with their own cookies and
# their own chosen store. Which one a run used is reported by BrowserSession.diagnostics().
# BROWSER_CDP_PROFILE_DIR=~/.storesplit/chrome-cdp-profile
# The host's own Chrome rather than Playwright's bundled Chromium.
BROWSER_CHANNEL=chrome
# Headed, so a challenge is something a person can actually answer.
BROWSER_HEADLESS=false
# Deliberately slower than the HTTP path, and measured rather than guessed: six page loads
# two seconds apart was enough to put both Target and Walmart back behind a challenge a human
# had just cleared, so the floor sits well above that.
BROWSER_MIN_REQUEST_INTERVAL_SECONDS=6.0
# How long a challenged retailer waits for a human before giving up for this run. The wait
# is passive: the page is watched, never reloaded, because reloading throws away a
# press-and-hold somebody is partway through. Raise this if you need longer at the keyboard.
BROWSER_MANUAL_VERIFICATION_TIMEOUT_SECONDS=600
# How often the parked page is read while waiting (a read, not a reload).
BROWSER_MANUAL_VERIFICATION_POLL_SECONDS=5
# How often to log the time remaining, so a long wait is visible rather than silent.
BROWSER_MANUAL_VERIFICATION_REPORT_SECONDS=60
# How long a page load's own data calls are reused instead of loading the page again. A load is
# the most expensive request here, and two callers want the same page routinely: the store the
# session is shopping is read off a category page, and that category is then searched. Kept short
# on purpose: offers are stamped when they are written, so reuse spanning two scrapes would
# publish prices the second one never fetched as prices read just now. To ask Target less often,
# raise SEARCH_FRESHNESS_TTL_SECONDS / SEARCH_REFRESH_COOLDOWN_SECONDS instead. 0 is off.
BROWSER_CAPTURE_TTL_SECONDS=120
# How long a retailer parked on a challenge answers "still parked" without loading the page
# again. Reloading a challenge is useless and makes it worse; after this, one ask is allowed
# in case a person has since finished it.
BROWSER_CHALLENGE_RETRY_INTERVAL_SECONDS=300

# -- Search freshness ---------------------------------------------------------------
# How old prices may be before a search revalidates in the background (default 30 min).
SEARCH_FRESHNESS_TTL_SECONDS=1800
# Whether a stale search starts that refresh itself.
SEARCH_AUTO_REFRESH=true
# Minimum spacing between refresh starts for one (ZIP, category); the manual refresh
# button counts down from this, and the API enforces it.
SEARCH_REFRESH_COOLDOWN_SECONDS=300
